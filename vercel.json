{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist",
        "installCommand": "npm install --legacy-peer-deps",
        "buildCommand": "npm run build",
        "includeFiles": ["public/videos/**"]
      }
    },
    {
      "src": "api/send-email.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/jobhunt.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "jobhunt/dashboard-template.html", "jobhunt/sign-in.html",
          "node_modules/pdfjs-dist/build/pdf.min.mjs", "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
          "node_modules/fflate/package.json", "node_modules/fflate/esm/browser.js"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml"
      }
    },
    {
      "src": "/sitemap-index.xml", 
      "dest": "/sitemap-index.xml",
      "headers": {
        "Content-Type": "application/xml"
      }
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt",
      "headers": {
        "Content-Type": "text/plain"
      }
    },
    {
      "src": "/assets/(.*)",
      "headers": { 
        "Cache-Control": "public, max-age=31536000, immutable" 
      }
    },
    {
      "src": "/api/send-email",
      "dest": "/api/send-email.js",
      "methods": ["POST"]
    },
    {
      "src": "/jobhunt/?",
      "dest": "/api/jobhunt.js"
    },
    {
      "src": "/api/jobhunt/?",
      "dest": "/api/jobhunt.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
