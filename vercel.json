{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/plugin-react",
      "config": {      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "status": 200
    }
  ]

}
